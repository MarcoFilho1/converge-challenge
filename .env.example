DATABASE_URL=postgres://consultorio:consultorio@localhost:5434/consultorio
TEST_DATABASE_URL=postgres://consultorio:consultorio@localhost:5434/consultorio_test
EVOLUTION_URL=http://localhost:8082
EVOLUTION_API_KEY=consultorio-dev-key
EVOLUTION_INSTANCE=consultorio
WEBHOOK_SECRET=consultorio-webhook-dev
APP_PUBLIC_URL=http://host.docker.internal:3100
WHATSAPP_DRY_RUN=false
# mock (sem chave), featherless (FEATHERLESS_API_KEY_1, _2…) ou gateway (AI_GATEWAY_API_KEY)
AI_PROVIDER=mock
# Featherless: quando uma chave fica sem crédito, o sistema passa para a próxima; se o modelo falhar, tenta o reserva
FEATHERLESS_API_KEY_1=
FEATHERLESS_API_KEY_2=
AI_CHAT_MODEL_FALLBACK=deepseek-ai/DeepSeek-V3-0324
# Tarefas rápidas no meio da conversa (interpretar, reagir, extrair): modelo mais rápido e limite menor
AI_FAST_MODEL=moonshotai/Kimi-K2-Instruct-0905
AI_FAST_MODEL_FALLBACK=Qwen/Qwen3-30B-A3B-Instruct-2507
AI_FAST_TIMEOUT_MS=7000
AI_FAST_BUDGET_MS=14000
AI_CALL_TIMEOUT_MS=45000
AI_GATEWAY_API_KEY=
AI_CHAT_MODEL=anthropic/claude-sonnet-5-5
AI_EMBEDDING_MODEL=openai/text-embedding-3-small
DEMO_SHORT=false
DOCTOR_NAME=Dra. Ana Lima
# Entrevista por voz (MVP2)
VOICE_PROVIDER=none
VOICEBOX_URL=http://127.0.0.1:17493
VOICEBOX_PROFILE_ID=
VOICEBOX_LANGUAGE=pt
VOICEBOX_ENGINE=kokoro
VOICEBOX_STT_MODEL=turbo
INTERVIEW_MODE=live
INTERVIEWER_NAME=Helena
INTERVIEW_PUBLIC_URL=http://localhost:3100
# VOICE_PROVIDER=elevenlabs: fala na ElevenLabs, escuta no Whisper do Voicebox
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# ElevenLabs: chaves extras usadas quando a cota da anterior acaba
ELEVENLABS_API_KEY_2=

# Convite automático para a entrevista no fim do questionário (ligado por padrão).
# Convida quem tem índice de bem-estar abaixo do limite (0 a 100) ou prioridade/atenção pela regra. Urgência nunca.
INTERVIEW_AUTO_INVITE=true
INTERVIEW_INVITE_THRESHOLD=70
